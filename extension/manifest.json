    "https://maxai.me/*",
    "https://www.maxai.me/*",
    "https://harpa.ai/*",
    "https://www.harpa.ai/*",
    "https://chathub.gg/*",
    "https://www.chathub.gg/*",
    "https://t3.chat/*",
    "https://duck.ai/*",
    "https://lumo.proton.me/*",
    "https://chat.reka.ai/*",
    "https://genspark.ai/*",
    "https://www.genspark.ai/*",
    "https://felo.ai/*",
    "https://www.felo.ai/*",
    "https://character.ai/*",
    "https://www.character.ai/*",
    "https://venice.ai/*",
    "https://www.venice.ai/*",
    "https://phind.com/*",
    "https://www.phind.com/*",
    "https://openrouter.ai/*",
    "https://www.openrouter.ai/*",
    "https://console.groq.com/*",
    "https://aistudio.google.com/*",
    "https://platform.openai.com/*",
    "https://console.anthropic.com/*",
    "https://fal.ai/*",
    "https://www.fal.ai/*",
    "https://cursor.com/*",
    "https://www.cursor.com/*",
    "https://windsurf.com/*",
    "https://www.windsurf.com/*",
    "https://v0.app/*",
    "https://v0.dev/*",
    "https://bolt.new/*",
    "https://www.bolt.new/*",
    "https://lovable.dev/*",
    "https://www.lovable.dev/*",
    "https://app.devin.ai/*",
    "https://midjourney.com/*",
    "https://www.midjourney.com/*",
    "https://suno.com/*",
    "https://www.suno.com/*",
    "https://elevenlabs.io/*",
    "https://www.elevenlabs.io/*",
    "https://app.leonardo.ai/*",
    "https://ideogram.ai/*",
    "https://www.ideogram.ai/*",
    "https://runwayml.com/*",
    "https://app.runwayml.com/*",
    "https://krea.ai/*",
    "https://www.krea.ai/*",
    "https://replicate.com/*",
    "https://www.replicate.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Usage Detector",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "sites.js",
        "settings.js",
        "readers.js",
        "content/common.js",
        "content/overlay.js",
        "content/claude.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "sites.js",
        "settings.js",
        "readers.js",
        "content/common.js",
        "content/overlay.js",
        "content/chatgpt.js"
      ],
      "run_at": "document_idle"
    },
